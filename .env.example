# Copy this file to .env and adjust the values for your environment.

APP_NAME="Student Document Request System"

# local = show PHP errors on screen. Use production on a live server.
APP_ENV=local

# Full address of the project, without a trailing slash.
APP_URL=http://localhost/college-document-request

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=college_document_request
DB_USER=root
DB_PASS=

# Seconds of inactivity before a user is signed out.
SESSION_LIFETIME=7200
